  "state_rules": [
    {
      "expression": "sassy",
      "when": "last request errored / rate-limited response / auth problem",
      "hold_ms": 4000
    },
    {
      "expression": "panic",
      "when": "usage_pct >= 100 (limit hit)"
    },
    {
      "expression": "despair",
      "when": "usage_pct >= 95"
    },
    {
      "expression": "shocked",
      "when": "burn spike: usage_pct rose >= 10 points within 2 minutes",
      "hold_ms": 3000
    },
    {
      "expression": "nervous",
      "when": "usage_pct >= 85"
    },
    {
      "expression": "flustered",
      "when": "weekly_pct >= 80 (weekly cap closing in, session still OK)"
    },
    {
      "expression": "cheerful",
      "when": "app just started, or window just reset",
      "hold_ms": 4000
    },
    {
      "expression": "sleepy",
      "when": "no activity for >= 10 minutes"
    },
    {
      "expression": "glare",
      "when": "usage_pct >= 75"
    },
    {
      "expression": "annoyed",
      "when": "usage_pct >= 60"
    },
    {
      "expression": "determined",
      "when": "actively generating AND model is opus"
    },
    {
      "expression": "focused",
      "when": "actively generating / running tools"
    },
    {
      "expression": "bliss",
      "when": "usage_pct < 10"
    },
    {
      "expression": "relaxed",
      "when": "idle 1-10 minutes AND usage_pct < 40"
    },
    {
      "expression": "neutral",
      "when": "otherwise"
    }
  ],
  "paths": {
    "ansi_truecolor": "ansi/truecolor/{outfit}/{expression}.{frame}.ans",
    "ansi_256": "ansi/ansi256/{outfit}/{expression}.{frame}.ans",
    "png_12x": "png/{outfit}/{expression}.{frame}.png",
    "pixels": "sprites.json"
  }
}